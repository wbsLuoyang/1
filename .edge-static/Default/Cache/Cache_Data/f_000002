<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>绘梨衣集群控制台</title>
<style>
:root{
  --ink:#5b4a78; --ink-soft:#8a7aa8; --ink-faint:#b3a6c9;
  --purple:#8b5cf6; --purple-deep:#6d28d9; --pink:#ec4899; --pink-soft:#f9a8d4;
  --bg-a:#fdf6fc; --bg-b:#f4ecff;
  --glass:rgba(255,255,255,.55); --glass-border:rgba(255,255,255,.75);
  --ok:#10b981; --warn:#f59e0b; --bad:#ef4444;
  --shadow:0 10px 30px rgba(139,92,246,.10), 0 2px 8px rgba(139,92,246,.06);
  --r:20px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  color:var(--ink);
  background:linear-gradient(135deg,var(--bg-a),var(--bg-b));
  min-height:100vh;overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
/* 流动光斑背景 */
.blob{position:fixed;border-radius:50%;filter:blur(90px);opacity:.55;z-index:0;pointer-events:none;animation:drift 18s ease-in-out infinite}
.blob.b1{width:420px;height:420px;background:#f9d5f0;top:-120px;left:-80px}
.blob.b2{width:380px;height:380px;background:#dcd2fb;bottom:-120px;right:-60px;animation-delay:-6s}
.blob.b3{width:300px;height:300px;background:#ffe3f0;top:40%;right:20%;animation-delay:-12s}
@keyframes drift{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(40px,-30px) scale(1.06)}66%{transform:translate(-30px,24px) scale(.96)}}
.wrap{position:relative;z-index:1;max-width:1160px;margin:0 auto;padding:28px 20px 60px}
/* 顶栏 */
header{display:flex;align-items:center;gap:16px;margin-bottom:22px}
.brand{display:flex;align-items:center;gap:12px}
.brand .logo{width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,var(--purple),var(--pink));display:grid;place-items:center;box-shadow:0 8px 20px rgba(139,92,246,.35)}
.brand .logo svg{width:24px;height:24px}
.brand h1{font-size:20px;font-weight:700;letter-spacing:.5px}
.brand .sub{font-size:12px;color:var(--ink-soft);margin-top:2px}
.spacer{flex:1}
.btn-icon{width:40px;height:40px;border-radius:12px;border:1px solid var(--glass-border);background:var(--glass);backdrop-filter:blur(16px);color:var(--ink-soft);cursor:pointer;display:grid;place-items:center;transition:.2s}
.btn-icon:hover{color:var(--purple);transform:translateY(-2px);box-shadow:var(--shadow)}
.btn-icon svg{width:19px;height:19px}
/* 导航 */
nav{display:flex;gap:8px;margin-bottom:22px;flex-wrap:wrap;background:var(--glass);backdrop-filter:blur(18px);border:1px solid var(--glass-border);border-radius:16px;padding:6px;width:max-content;box-shadow:var(--shadow)}
nav .tab{border:none;background:transparent;color:var(--ink-soft);padding:9px 18px;border-radius:11px;cursor:pointer;font-size:14px;transition:.22s;display:flex;align-items:center;gap:8px}
nav .tab svg{width:16px;height:16px;opacity:.7}
nav .tab:hover{color:var(--ink)}
nav .tab.active{background:linear-gradient(135deg,var(--purple),var(--pink));color:#fff;box-shadow:0 6px 16px rgba(139,92,246,.35)}
.panel{display:none;animation:fade .35s ease}
.panel.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.glass{padding:20px;border-radius:var(--r);background:var(--glass);border:1px solid var(--glass-border);backdrop-filter:blur(18px);box-shadow:var(--shadow)}
.card-h{display:flex;align-items:center;gap:10px;margin-bottom:16px;font-size:16px;font-weight:600}
.card-h svg{width:20px;height:20px;color:var(--purple)}
.card-h .right{margin-left:auto;display:flex;gap:8px;align-items:center}
/* 按钮 */
.btn{display:inline-flex;align-items:center;gap:7px;border:none;cursor:pointer;border-radius:12px;padding:9px 16px;font-size:13px;font-weight:600;transition:.2s}
.btn svg{width:15px;height:15px}
.btn.primary{background:linear-gradient(135deg,var(--purple),var(--pink));color:#fff;box-shadow:0 6px 14px rgba(139,92,246,.3)}
.btn.primary:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(139,92,246,.4)}
.btn.ghost{background:rgba(255,255,255,.6);color:var(--ink-soft);border:1px solid var(--glass-border)}
.btn.ghost:hover{color:var(--purple);background:#fff}
.btn.sm{padding:6px 11px;font-size:12px;border-radius:9px}
.btn:disabled{opacity:.55;cursor:not-allowed;transform:none!important}
/* 服务器区 */
.server{margin-bottom:24px}
.server-head{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.server-head .name{font-size:16px;font-weight:700}
.pill{font-size:11px;padding:3px 9px;border-radius:20px;font-weight:600}
.pill.ok{background:rgba(16,185,129,.14);color:var(--ok)}
.pill.warn{background:rgba(245,158,11,.16);color:var(--warn)}
.pill.bad{background:rgba(239,68,68,.14);color:var(--bad)}
.pill.flat{background:rgba(139,92,246,.12);color:var(--purple)}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.chip{display:flex;align-items:center;gap:7px;background:var(--glass);border:1px solid var(--glass-border);border-radius:12px;padding:7px 13px;font-size:12px;color:var(--ink-soft);backdrop-filter:blur(10px)}
.chip b{color:var(--ink);font-size:13px}
.chip svg{width:15px;height:15px}
/* 告警条 */
.alertbanner{margin-bottom:14px;padding:12px 16px;border-radius:14px;display:flex;align-items:center;gap:10px;font-size:13px}
.alertbanner svg{width:17px;height:17px;flex:none}
.alertbanner.warn{background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.3);color:#b45309}
.alertbanner.bad{background:rgba(239,68,68,.10);border:1px solid rgba(239,68,68,.28);color:#b91c1c}
.alertbanner .btns{margin-left:auto;display:flex;gap:8px}
/* 角色卡片网格 */
.roles{display:grid;grid-template-columns:repeat(auto-fill,minmax(248px,1fr));gap:14px}
.rcard{position:relative;padding:16px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-border);backdrop-filter:blur(18px);box-shadow:var(--shadow);transition:.25s;overflow:hidden}
.rcard:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(139,92,246,.16)}
.rcard::before{content:"";position:absolute;inset:0 0 auto 0;height:3px;background:linear-gradient(90deg,var(--purple),var(--pink));opacity:0;transition:.25s}
.rcard:hover::before{opacity:1}
.rcard.focus ::before{opacity:1}
.rcard .top{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.dot{width:10px;height:10px;border-radius:50%;flex:none;box-shadow:0 0 0 4px rgba(0,0,0,.04)}
.dot.ok{background:var(--ok)} .dot.warn{background:var(--warn)} .dot.bad{background:var(--bad)} .dot.off{background:#cbd5e1}
.rcard .nm{font-size:15px;font-weight:700}
.rcard .meta{font-size:11px;color:var(--ink-faint);margin-top:2px;letter-spacing:.3px}
.badges{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.badge{font-size:11px;padding:3px 8px;border-radius:8px;font-weight:600}
.badge.warn{background:rgba(245,158,11,.15);color:#b45309}
.badge.bad{background:rgba(239,68,68,.13);color:#b91c1c}
.badge.dim{background:rgba(139,92,246,.10);color:var(--purple)}
.badge.ok{background:rgba(16,185,129,.14);color:var(--ok)}
.sm-select{width:190px;flex:none}
.quota{margin-bottom:14px}
.qrow{display:flex;align-items:center;gap:10px;padding:8px 4px;border-bottom:1px solid rgba(139,92,246,.10);flex-wrap:wrap}
.qrow:last-child{border-bottom:none}
.qname{min-width:110px;font-weight:600;font-size:13px}
.qstat{flex:1;font-size:12px;color:var(--ink-soft)}
.qstat b{color:var(--purple);font-size:13px}
.qin{width:96px;flex:none;padding:6px 10px}
.rcard .acts{display:flex;gap:8px}
.rcard .acts .btn{flex:1;justify-content:center}
.rcard .act-open{background:linear-gradient(135deg,var(--purple),var(--pink));color:#fff}
/* 日志 */
.logbox{background:rgba(255,255,255,.7);border:1px solid var(--glass-border);border-radius:14px;padding:14px;font-size:12px;line-height:1.7;color:#6b5b8c;white-space:pre-wrap;max-height:60vh;overflow:auto;font-family:ui-monospace,Consolas,monospace}
/* 表单 */
label{display:block;font-size:12px;color:var(--ink-soft);margin:12px 0 5px}
input,textarea,select{width:100%;background:rgba(255,255,255,.7);border:1px solid var(--glass-border);color:var(--ink);border-radius:12px;padding:10px 13px;font-size:14px;font-family:inherit;transition:.2s}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 3px rgba(139,92,246,.16);background:#fff}
textarea{min-height:110px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.msg{margin-top:12px;padding:11px 13px;border-radius:12px;font-size:13px;display:none;line-height:1.6}
.msg.ok{display:block;background:rgba(16,185,129,.12);color:#047857}
.msg.err{display:block;background:rgba(239,68,68,.10);color:#b91c1c}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:9px 10px;border-bottom:1px solid rgba(139,92,246,.10)}
th{color:var(--ink-soft);font-weight:600;font-size:12px}
.mono{font-family:ui-monospace,Consolas,monospace}
.qr{max-width:210px;border-radius:14px;background:#fff;padding:8px}
.grid-qr{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px;margin-top:10px}
.qr-card{text-align:center}
.qr-card .nm{font-size:13px;margin-bottom:8px;font-weight:600}
.sub{color:var(--ink-soft);font-size:13px}
/* 加载 */
.skeleton{display:flex;flex-direction:column;gap:12px}
.sk{height:20px;border-radius:10px;background:linear-gradient(90deg,rgba(139,92,246,.08),rgba(236,72,153,.10),rgba(139,92,246,.08));background-size:200% 100%;animation:shimmer 1.4s infinite}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:#d9cdf0;border-radius:9px}
@media(max-width:640px){.row{grid-template-columns:1fr}nav{width:100%}}
</style>
</head>
<body>
<div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
<div class="wrap">
  <header>
    <div class="brand">
      <div class="logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 4v5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V7z"/><path d="M9 12l2 2 4-4"/></svg>
      </div>
      <div>
        <h1>绘梨衣集群控制台</h1>
        <div class="sub">角色状态 · 一键面板 · 引擎管理</div>
      </div>
    </div>
    <div class="spacer"></div>
    <button class="btn-icon" id="global-refresh" title="刷新状态">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
    </button>
  </header>

  <nav>
    <button class="tab active" data-t="dash"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/></svg>状态看板</button>
    <button class="tab" data-t="create"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>新建智能体</button>
