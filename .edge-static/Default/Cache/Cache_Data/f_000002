<script>
const IC = { refresh:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>' };
let SERVERS=[], PANELS={};
async function api(p,o){const r=await fetch(p,o);return r.json();}
document.querySelectorAll('nav .tab').forEach(t=>{t.onclick=()=>{document.querySelectorAll('nav .tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));t.classList.add('active');document.getElementById('p-'+t.dataset.t).classList.add('active');};});

function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function cat(r){
  if(r&&r.dup) return 'dup';
  const on=r&&r.realOnline;
  if(on===true) return 'online';
  if(on===false) return (r.nodeConns>0&&r.engineCount>0)?'kicked':'down';
  if(r&&r.engineCount>0 && !r.engineOffline) return 'online';
  if(r&&r.engineOffline && r.engineCount>0) return 'kicked';
  return 'down';
}
function stateOf(r){const c=cat(r);return {online:{cls:'ok',txt:'在线'},kicked:{cls:'warn',txt:'账号未登录'},down:{cls:'off',txt:'引擎未运行'},dup:{cls:'bad',txt:'重复引擎'}}[c];}

async function loadPanels(){ try{PANELS=(await api('/api/panels')).servers||{};}catch(e){PANELS={};} }
function panelOf(key,name){const p=(PANELS[key]||{});return p.url?`${p.url}/${encodeURIComponent(name)}`:'';}

// ---------- 看板 ----------
async function loadDash(){
  const box=document.getElementById('dash-body');
  box.innerHTML='<div class="skeleton"><div class="sk"></div><div class="sk"></div><div class="sk"></div></div>';
  const j=await api('/api/status');
  if(!j||!j.servers){box.innerHTML='<div class="alertbanner bad"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>控制台后端无响应，请确认已用 start.bat 启动。</div>';return;}
  let html='';
  for(const s of j.servers){
    if(!s.ok){html+=`<div class="server"><div class="server-head"><span class="name">${esc(s.name)}</span><span class="pill bad">连接失败</span></div><div class="alertbanner bad"><span>${esc(s.error)}</span></div></div>`;continue;}
    const roles=s.roles||[];
    const catCount=(c)=>roles.filter(r=>cat(r)===c).length;
    const online=catCount('online');
    const kicked=catCount('kicked');
    const dups=catCount('dup');
    const down=roles.length-online-kicked-dups;
    const leftovers=s.leftovers||[]; const orphans=s.orphans||[];
    const panelPill=s.panelListen=='OK'?'<span class="pill ok">面板在线</span>':'<span class="pill bad">面板未监听</span>';
    html+=`<div class="server">
      <div class="server-head"><span class="name">${esc(s.name)}</span>${panelPill}
        <div class="spacer"></div>
        <button class="btn ghost sm" onclick="restartServer('${s.key}')">重启全部引擎</button></div>
      <div class="chips">
        <span class="chip">在线 <b>${online}</b></span>
        ${kicked?`<span class="chip" style="color:var(--warn);font-weight:700">账号未登录 <b>${kicked}</b></span>`:''}
        <span class="chip" style="${dups?'color:var(--bad)':''}">重复引擎 <b>${dups}</b></span>
        <span class="chip">下线 <b>${down}</b></span>
        <span class="chip">引擎 <b>${roles.reduce((a,r)=>a+(r.engineCount||0),0)}</b></span>
        ${s.panelUrl?`<span class="chip">面板已通</span>`:''}
      </div>`;
    // 语音额度面板（1.5元/万字符；余额用尽 AI 会拒绝发语音）
    if (s.quota && Object.keys(s.quota).length) {
      const qrows = (s.roles || []).map((r) => {
        const q = s.quota[r.name] || { quota: 0, used: 0 };
        const left = Math.max(0, (Number(q.quota) || 0) - (Number(q.used) || 0));
        return `<div class="qrow">
          <span class="qname">${esc(r.name)}</span>
          <span class="qstat">充 ¥${(Number(q.quota)||0).toFixed(2)} · 用 ¥${(Number(q.used)||0).toFixed(2)} · <b>剩 ¥${left.toFixed(2)}</b></span>
          <input class="qin" id="qin-${s.key}-${esc(r.name)}" type="number" min="0" step="0.5" value="${Number(q.quota)||0}">
          <button class="btn ghost sm" onclick="setQuota('${s.key}','${esc(r.name)}')">充值</button>
        </div>`;
      }).join('');
      html += `<div class="glass quota">
        <div class="card-h"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 0 1 6 6c0 2.5-1.5 3.5-2.5 4.5-.8.8-1 1.4-1 2.5h-5c0-1.1-.2-1.7-1-2.5C7.5 12.5 6 11.5 6 9a6 6 0 0 1 6-6z"/></svg>语音额度<small class="sub" style="font-weight:400">（1.5元/万字符，余额用尽后 AI 会发「语音余额不足」拒绝）</small></div>
        ${qrows}
      </div>`;
    }
    if(leftovers.length)html+=leftovers.map(l=>`<div class="alertbanner warn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg><div>检测到 <b>${l.engines.length}</b> 个迁移残留引擎（QQ ${l.qq}），不在本服务器角色清单内，占用内存。</div><div class="btns"><button class="btn ghost sm" onclick="killLeftovers('${s.key}','${l.qq}')">清理</button></div></div>`).join('');
    if(orphans.length)html+=`<div class="alertbanner bad"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg><div><b>${orphans.length}</b> 个孤儿引擎（无角色标识）</div></div>`;
    html+=`<div class="roles">`;
    for(const r of roles){
      if(!PANELS[s.key]){ PANELS[s.key]={}; }
      const st=stateOf(r); const c=cat(r);
      const badges=[];
      if(c==='dup')badges.push('<span class="badge bad">重复引擎</span>');
      else if(r.engineCount>1)badges.push(`<span class="badge bad">${r.engineCount}个引擎</span>`);
      if(c==='kicked')badges.push('<span class="badge warn">账号未登录(疑似被踢)</span>');
      else if(c==='online')badges.push('<span class="badge ok">在线</span>');
      else if(c==='down')badges.push('<span class="badge dim">引擎未运行</span>');
      const url=panelOf(s.key,r.name);
      const owner=(SERVERS.find(x=>x.key===s.key)?.roles||[]).find(ro=>ro.name===r.name);
      html+=`<div class="rcard">
        <div class="top"><span class="dot ${st.cls}"></span><span class="nm">${esc(r.name)}</span></div>
        <div class="meta">QQ ${esc(r.qq)} · 端口 ${r.port||'—'}${owner?' · 主人 '+esc(owner.owner):''}</div>
        <div class="badges">${badges.join('')||'<span class="badge dim">'+esc(st.txt)+'</span>'}</div>
        <div class="acts">
          <button class="btn act-open sm" onclick="openPanel('${url}')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>打开面板</button>
          <button class="btn ghost sm" onclick="restartRole('${s.key}','${r.name}',${r.port})">重启</button>
        </div>
      </div>`;
    }
    html+=`</div></div>`;
  }
  box.innerHTML=html||'<div class="sub">暂无服务器数据</div>';
}
function openPanel(url){ if(!url){alert('面板地址暂不可用，请先在服务器启动 cloudflared 隧道');return;} window.open(url,'_blank'); }
// 设置语音额度（充值金额元）
async function setQuota(key,name){
  const inp=document.getElementById('qin-'+key+'-'+name);
  const yuan=parseFloat(inp.value);
  if(isNaN(yuan)||yuan<0){alert('请输入有效的充值金额');return;}
  if(!confirm('给「'+name+'」语音额度充值 ¥'+yuan.toFixed(2)+' ？（不足时 AI 拒绝发语音）'))return;
  try{
    const j=await api('/api/quota-set',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({server:key,role:name,yuan})});
    if(j.ok){ await loadDash(); }
    else{ alert('设置失败：'+(j.error||'未知')); }
  }catch(e){ alert('请求失败：'+e.message); }
}

// ---------- 重启 ----------
function restartServer(key){ if(!confirm('确定重启该服务器全部引擎？（会断开现有对话）'))return; doRestart(key,null); }
function restartRole(key,name,port){ if(!confirm(`确定重启「${name}」引擎？`))return; doRestart(key,[{name,port}]); }
async function doRestart(key,roles){
  const box=document.getElementById('dash-body');
  const msg=document.createElement('div');
  msg.className='glass'; msg.style.marginBottom='16px';
  msg.innerHTML='<div class="card-h">引擎重启中，请稍候…</div>';
  box.prepend(msg);
  try{
    const j=await api('/api/restart',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({server:key,roles})});
    msg.innerHTML=`<div class="card-h">重启完成</div><div class="logbox">${esc(j.log||j.error||'')}</div>`;
  }catch(e){msg.innerHTML=`<div class="card-h">重启失败</div><div class="logbox">${esc(e.message)}</div>`;}
  await loadDash();
}

// ---------- 清理残留 ----------
async function killLeftovers(key,qq){
  if(!confirm(`确定清理 QQ ${qq} 的残留引擎？（仅杀进程，不影响其它）`))return;
  const j=await api('/api/restart',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({server:key,cleanLeftoverQQ:String(qq)})});
  await loadDash();
}

// ---------- 初始化服务器 ----------
async function initServers(){
  const j=await api('/api/servers'); SERVERS=j.servers||[];
  const sel=document.getElementById('c-server');
  sel.innerHTML=SERVERS.map(s=>`<option value="${s.key}">${s.name}（${s.roles.length} 个角色）</option>`).join('');
  // 二维码：选服务器 → 选角色 → 获取
  const qsrv=document.getElementById('qr-server');
  qsrv.innerHTML=SERVERS.map(s=>`<option value="${s.key}">${s.name}</option>`).join('');
  qsrv.onchange=fillQrRoles;
  document.getElementById('btn-loadqr').onclick=loadQr;
  fillQrRoles();
}
function fillQrRoles(){
  const key=document.getElementById('qr-server').value;
  const srv=SERVERS.find(x=>x.key===key);
  const qr=document.getElementById('qr-role');
  qr.innerHTML=(srv?srv.roles:[]).map(r=>`<option value="${r.qq}">${esc(r.name)} (${r.qq})</option>`).join('');
}
document.getElementById('btn-create').onclick=async()=>{
  const btn=document.getElementById('btn-create'),msg=document.getElementById('create-msg');
  const body={server:document.getElementById('c-server').value,name:document.getElementById('c-name').value.trim(),qq:document.getElementById('c-qq').value.trim(),pass:document.getElementById('c-pass').value.trim(),ownerQQ:document.getElementById('c-owner').value.trim(),port:parseInt(document.getElementById('c-port').value,10)||null,model:document.getElementById('c-model').value.trim(),llmKey:document.getElementById('c-llm').value.trim(),voice:document.getElementById('c-voice').value.trim(),persona:document.getElementById('c-persona').value.trim()};
  if(!body.name||!body.qq){msg.className='msg err';msg.textContent='角色名和 QQ 号必填';return;}
  btn.disabled=true;msg.className='msg';msg.textContent='';
  try{const j=await api('/api/create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(j.ok){msg.className='msg ok';msg.textContent=`已创建「${j.name}」（${j.serverName||''}，端口 ${j.port}）。面板密码见密码清单，下一步扫码登录。`;}
    else{msg.className='msg err';msg.textContent='创建失败：'+(j.error||'未知');}
  }catch(e){msg.className='msg err';msg.textContent='请求失败：'+e.message;}
  finally{btn.disabled=false;}
};
document.getElementById('btn-pass').onclick=async()=>{
  const box=document.getElementById('pass-body');box.innerHTML='<div class="sub">加载中…</div>';
  const j=await api('/api/passwords');
  let h='';for(const s of j.servers||[]){
    const rows=Object.entries(s.roleTokens||{}).map(([n,p])=>`<tr><td>${esc(n)}</td><td class="mono">${esc(p)}</td></tr>`).join('');
    h+=`<h3 style="margin:16px 0 8px;font-size:14px">${esc(s.name)}</h3><table><tr><th>角色</th><th>面板密码</th></tr>${rows}</table>`;
  }
  box.innerHTML=h;
};
async function loadQr(){
  const key=document.getElementById('qr-server').value, qq=document.getElementById('qr-role').value;
  const srv=SERVERS.find(x=>x.key===key);const box=document.getElementById('qr-body');
  const role=(srv?srv.roles:[]).find(r=>String(r.qq)===String(qq));
  if(!role)return;box.innerHTML='<div class="sub">加载中…</div>';
  const j=await api('/api/qr?server='+key+'&qq='+role.qq);
  box.innerHTML=`<div class="qr-card"><div class="nm">${esc(role.name)}（${esc(role.qq)}）</div>${j.ok?`<img class="qr" src="data:image/png;base64,${j.qrBase64}"><div class="sub" style="margin-top:6px">${esc(j.mtime)}</div>`:`<div class="sub">${esc(j.error)}</div>`}</div>`;
}
document.getElementById('global-refresh').onclick=()=>{loadPanels().then(loadDash);};

// 启动
(async()=>{ await initServers(); await loadPanels(); await loadDash(); })();
</script>
</body>
</html>