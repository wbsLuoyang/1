{
  "name": "1",
  "outputDirectory": "public",
  "nodeVersion": "20.18.0",
  "cloudFunctions": {
    "mainlandRegions": ["ap-guangzhou"],
    "nodejs": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/api/*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/v1/*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
